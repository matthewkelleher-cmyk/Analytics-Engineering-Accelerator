# Copy to .env for local use. In Codespaces, set these as Codespaces secrets instead.
SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_USER=<your_user>
SNOWFLAKE_ROLE=<role_for_the_pipeline>
SNOWFLAKE_WAREHOUSE=<warehouse>
SNOWFLAKE_DATABASE=<database>
SNOWFLAKE_SCHEMA=<dbt_yourname>

# Password login (used by the throwaway test; likely replaced by a key pair)
SNOWFLAKE_PASSWORD=<password>

# Key-pair login (service user)
# SNOWFLAKE_PRIVATE_KEY_PATH=<path_to_private_key>
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=<passphrase>

# EIA open data API (v2) key. In Codespaces, set it as the secret EIA_API_KEY.
EIA_API_KEY=<your_eia_api_key>