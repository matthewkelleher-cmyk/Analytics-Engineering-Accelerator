# Copy to .env. Credentials (account, user, password or key, EIA key) can instead be
# Codespaces secrets; the role, warehouse and schema names below are not secrets.
SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_USER=<your_user>
SNOWFLAKE_ROLE=ENERGY_PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=ENERGY_WH
SNOWFLAKE_DATABASE=TIL_DATA_ENGINEERING
# dbt builds here while developing; the production run uses dbt_mk_stg, dbt_mk_int and dbt_mk_mart
SNOWFLAKE_SCHEMA=dbt_mk
# The loaders write raw rows here
SNOWFLAKE_RAW_SCHEMA=MK_RAW

# Password login (used by the loaders for now; likely replaced by a key pair)
SNOWFLAKE_PASSWORD=<password>

# Key-pair login (service user)
# SNOWFLAKE_PRIVATE_KEY_PATH=<path_to_private_key>
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=<passphrase>

# EIA open data API (v2) key. In Codespaces, set it as the secret EIA_API_KEY.
EIA_API_KEY=<your_eia_api_key>