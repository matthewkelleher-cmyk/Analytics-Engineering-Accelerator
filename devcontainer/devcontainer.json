{
  "name": "Analytics Engineering Accelerator",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "innoverio.vscode-dbt-power-user",
        "redhat.vscode-yaml",
        "snowflake.snowflake-vsc"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "dbt.dbtPythonPathOverride": "/usr/local/bin/python3",
        "dbt.projectDirs": ["dbt_project"]
      }
    }
  },
  "remoteEnv": {
    "DBT_PROFILES_DIR": "${containerWorkspaceFolder}/dbt_project"
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && python --version && dbt --version"
}